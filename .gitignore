# Godot 4
.godot/
.import/
/android/

# The dot-* addons are separate repositories and are linked in, never committed.
# For local development, symlink them from a sibling checkout:
#   ln -s ../../dot-core/addons/dot_core addons/dot_core
# bootstrap.sh derives this project's dependencies from the lines below, so a
# dependency added here is a dependency it links on the next run.
/addons/dot_core
/addons/dot_profile
/addons/dot_combat
/addons/dot_weapon
/addons/dot_net
/addons/dot_physics
/addons/dot_fx
/addons/dot_audio
/addons/dot_player
/addons/dot_player_controller
/addons/dot_player_char

# Exports
build/
export.cfg
export_presets.cfg
*.translation

# Screenshots are evidence for a review, not assets.
/screenshots/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Blender runs the art-src scripts and leaves bytecode beside them.
__pycache__/
art-src/reference/


# Opt-in 2K Poly Haven weapon glbs (tools/bake_polyhaven.py output) and the textures Godot extracts from them.
/addons/arena_weapons/assets/models/*_2k.glb*
/addons/arena_weapons/assets/models/*_ph_*.jpg*
/addons/arena_weapons/assets/models/*_2k.jpg*
